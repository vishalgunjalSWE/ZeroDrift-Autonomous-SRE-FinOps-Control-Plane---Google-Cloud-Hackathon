# ZeroDrift Execution Engine Environment Configuration (Render Web Service)

# Server port (automatically assigned by Render $PORT; default 8000 for local)
PORT=8000

# Configurable CORS Allowed Origins (comma-separated, without trailing slashes)
# Always includes localhost by default. Add your Vercel deployment URL here:
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-APP.vercel.app

# Optional AI Reasoning Engine (Google Gemini)
# If omitted or rate-limited, ZeroDrift activates its deterministic SRE policy fallback automatically:
# GEMINI_API_KEY=your_gemini_api_key_here
